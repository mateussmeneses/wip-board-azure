{
  "manifest_version": 3,
  "name": "Azure DevOps - Board WIP Monitor",
  "version": "1.3",
  "description": "Calculates board WIP with configurable columns, alerts, and optional special rules.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://*.visualstudio.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*/_boards/board/*",
        "https://*.visualstudio.com/*/_boards/board/*"
      ],
      "js": [
        "src/core/wip-logic.js",
        "src/core/board-identity.js",
        "src/data/board-dom-reader.js",
        "src/data/snapshot-store.js",
        "src/data/snapshot-capture.js",
        "src/features/daily/daily-commitment.js",
        "src/features/daily/commitment-picker.js",
        "src/features/daily/projected-board.js",
        "src/features/daily/daily-comparison.js",
        "src/features/daily/daily-history.js",
        "src/features/daily/daily-session.js",
        "src/features/sprint/sprint-scope.js",
        "src/features/sprint/sprint-baseline.js",
        "src/data/sprint-goal-store.js",
        "src/features/sprint/sprint-intelligence.js",
        "src/features/sprint/sprint-progress.js",
        "src/data/sprint-observation-store.js",
        "src/features/sprint/sprint-trends.js",
        "content.js"
      ],
      "run_at": "document_end",
      "css": [
        "src/ui/board.css",
        "src/ui/forms.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configurar WIP"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "version.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
