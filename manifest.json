{
  "manifest_version": 3,
  "name": "Azure DevOps - Board WIP Monitor",
  "version": "1.3",
  "description": "Calculates board WIP with configurable columns, alerts, and optional special rules.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://*.visualstudio.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*/_boards/board/*",
        "https://*.visualstudio.com/*/_boards/board/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configurar WIP"
  },
  "web_accessible_resources": [
  {
    "resources": ["version.json"],
    "matches": ["<all_urls>"]
  }
]
}